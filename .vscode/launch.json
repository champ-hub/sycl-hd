    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "CIFAR-10",
            "program": "${workspaceFolder}/build/examples/cifar10/cifar10",
            "args": "-vs 1000",
            "cwd": "${workspaceFolder}/build/examples/cifar10",
            "preLaunchTask": "Build CIFAR-10"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Language",
            "program": "${workspaceFolder}/build/examples/language/language",
            "args": "-vs 500",
            "cwd": "${workspaceFolder}/build/examples/language",
            "preLaunchTask": "Build Language"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "MNIST",
            "program": "${workspaceFolder}/build/examples/mnist/mnist",
            "args": "-vs 1000",
            "cwd": "${workspaceFolder}/build/examples/mnist",
            "preLaunchTask": "Build MNIST"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "NeuralHD MNIST",
            "program": "${workspaceFolder}/build/examples/mnist/mnist_rbf",
            "args": "-vs 2000",
            "cwd": "${workspaceFolder}/build/examples/mnist",
            "preLaunchTask": "Build MNIST RBF"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "VoiceHD",
            "program": "${workspaceFolder}/build/examples/voicehd/voicehd",
            "args": "-rt 0 -a -1 -rg 100",
            "cwd": "${workspaceFolder}/build/examples/voicehd",
            "preLaunchTask": "Build VoiceHD"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Dollar of Mexico",
            "program": "${workspaceFolder}/build/examples/dofmex/dofmex",
            "args": [],
            "cwd": "${workspaceFolder}/build/examples/dofmex",
            "preLaunchTask": "Build dofmex"
        },    
        {
            "type": "lldb",
            "request": "launch",
            "name": "HDNA Bats",
            "program": "${workspaceFolder}/build/examples/hdna/hdna",
            "args": "-vs 100",
            "cwd": "${workspaceFolder}/build/examples/hdna",
            "preLaunchTask": "Build HDNA"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "HDNA Splice",
            "program": "${workspaceFolder}/build/examples/hdna/hdna_",
            "args": "-vs 100",
            "cwd": "${workspaceFolder}/build/examples/hdna",
            "preLaunchTask": "Build HDNA"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "C-MAPSS",
            "program": "${workspaceFolder}/build/examples/cmapss/cmapss",
            "args": "-vs 1000 -ps 201",
            "cwd": "${workspaceFolder}/build/examples/cmapss",
            "preLaunchTask": "Build C-MAPSS"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Tests",
            "program": "${workspaceFolder}/build/tests/syclhd_tests",
            "args": [],
            "cwd": "${workspaceFolder}/build/tests",
            "preLaunchTask": "Build tests"
        },        
        {
            "type": "lldb",
            "request": "launch",
            "name": "EMG",
            "program": "${workspaceFolder}/build/examples/emg/emg",
            "args": "-host 1",
            "cwd": "${workspaceFolder}/build/examples/emg/",
            "preLaunchTask": "Build emg"
        }
    ]
}
